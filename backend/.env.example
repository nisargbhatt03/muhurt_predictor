# Server Mode: development or production
ENV_MODE=development

# PostgreSQL Connection Details
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=muhurt_db

# Full Database URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/muhurt_db

# Security & JWT Token Configuration
JWT_SECRET_KEY=muhurt_secret_sacred_key_change_in_production_987654321
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Whitelist (Comma-separated origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
