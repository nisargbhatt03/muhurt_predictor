[Unit]
Description=Muhurt Predictor FastAPI Backend Service
After=network.target postgresql.service

[Service]
User=ubuntu
WorkingDirectory=/var/www/muhurt-predictor/backend
ExecStart=/var/www/muhurt-predictor/backend/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 4
Restart=always
RestartSec=5
Environment=PATH=/var/www/muhurt-predictor/backend/venv/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=multi-user.target
